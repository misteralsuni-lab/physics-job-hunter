# Physics Job Hunter — Front End Environment Variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` to git — it may contain live credentials.
#
# All Supabase access is server-side only. The service-role key MUST NOT be
# exposed to the browser. Reads are performed in server components / route
# handlers and serialised as plain JSON to the client.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=""

# Service-role key — SERVER SIDE ONLY. Used by route handlers / server
# components to query the `job_listings` table.
SUPABASE_SERVICE_ROLE_KEY=""

# Anon/public key — OPTIONAL. Only present if your Supabase project exposes
# one. If absent, all reads continue to go through server-side route handlers.
SUPABASE_ANON_KEY=""

# ── Pipeline integration ───────────────────────────────────────────────
# Absolute path to the Python project root. The pipeline-run API route spawns
# `python3 -m src.main` with this as its working directory.
PIPELINE_CWD="/mnt/d/physics-job-hunter"

# systemd user unit that arms the APScheduler loop.
SYSTEMD_UNIT="physics-job-hunter.service"

# ── Admin access control ───────────────────────────────────────────────
# Shared secret required on all mutating pipeline endpoints. Clients must send
# it in the `x-admin-token` header. If unset, mutating endpoints fall back to
# localhost-only access (127.0.0.1 / ::1).
ADMIN_TOKEN=""

# ── Advisory settings mirror ───────────────────────────────────────────
# These mirror the Python pipeline's `.env` for display in the Settings page.
# The Python scheduler is the source of truth; editing these here is advisory
# unless you also update the root `.env` and restart the service.
NOTIFY_SCORE_THRESHOLD="50"
SCHEDULE_TIME="08:00,17:00,22:00,22:30,23:00"
