# Physics Job Hunter — Environment Variables
#
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` to git — it contains live API keys.
# ── LLM Scoring ─────────────────────────────────────────────────────────
# Primary LLM provider (opencode_zen | gemini | nvidia)
SCORER_PROVIDER=opencode_zen

# Fallback LLM provider (used if primary fails during startup probe)
SCORER_FALLBACK=gemini

# opencode_zen
OPENCODE_ZEN_API_KEY=""

# Google Gemini — get free key at https://aistudio.google.com/
GEMINI_API_KEY=""

# NVIDIA
NVIDIA_API_KEY=""
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenRouter — alternative with higher rate limits (no free-tier RPM cap)
# Sign up at https://openrouter.ai/keys and create a free API key
# Uses free models like google/gemini-2.5-flash-exp-free:free
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Telegram ─────────────────────────────────────────────────────────────
# Get bot token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Email ────────────────────────────────────────────────────────────────
# ---- Email digest (OPTIONAL — Telegram is the primary alert channel) -----
# The pipeline does NOT require email. If you leave this unset, alerts still
# arrive via Telegram and the log states plainly that email is off.
#
# EMAIL_PROVIDER must be exactly "resend", "smtp", or empty.
# EMPTY = email disabled (recommended until you have a sender address).
EMAIL_PROVIDER=""
#
# Resend: https://resend.com/api-keys  -> set EMAIL_PROVIDER=resend
#   RESEND_API_KEY:  re_...   (starts with "re_")
#   EMAIL_FROM:  a domain you have VERIFIED in Resend, e.g. alerts@yourdomain.com
#   EMAIL_TO:    where the digest goes, e.g. you@gmail.com
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_TO=""
#
# SMTP alternative: EMAIL_PROVIDER=smtp
#   For Gmail use an App Password (Google Account -> Security -> 2-Step
#   Verification -> App passwords), not your account password.
#   EMAIL_FROM may be left blank to default to SMTP_USER.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ── Firecrawl (Research Agent deep scraping) ────────────────────────────
# Sign up at https://firecrawl.dev and get an API key
FIRECRAWL_API_KEY=""

# ── Research Agent ───────────────────────────────────────────────────────
# Minimum job score required to trigger deep research (default 80)
RESEARCH_SCORE_THRESHOLD=60

# ── Alerts ───────────────────────────────────────────────────────────────
# Minimum score to send a Telegram/email alert (default 50)
NOTIFY_SCORE_THRESHOLD=50
# How old a posting may be (in days, measured from the day we FIRST saw it)
# before it stops producing alerts. Guards against zombie listings that a
# board keeps re-serving: most rows carry no closing date, and TES's payload
# has no date field at all, so first-seen age is the only usable signal.
# 0 disables the gate. Raise it if you want older vacancies to surface.
MAX_JOB_AGE_DAYS=45

# ── Scraper toggles ──────────────────────────────────────────────────────
# GulfTalent is opt-in. Its /api/jobs/search endpoint sits behind Cloudflare
# which throttles most bursts even with correct headers, and it is a corporate
# Gulf employment board where "physics" matches medical physicists and
# engineers rather than teachers. Measured yield while reachable: 0 teaching
# roles. Set to 1 to attempt it anyway (costs ~80s per run).
GT_ENABLED=0
# SeekTeachers: "targets" restricts to profile.json target_countries;
# "all" sweeps every country the physics keyword discovers.
SEEK_COUNTRIES=targets
# Stealth browser fleet (toptutorjob / search_associates / teacher_horizons).
# Requires a prior `python -m camoufox fetch` (~1.3 GB) or these stay dormant.
CAMOUFOX_ENABLED=0

# ── Scheduler ────────────────────────────────────────────────────────────
SCHEDULE_TIME=08:00,17:00,22:00,22:30,23:00
